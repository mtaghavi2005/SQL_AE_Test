# Local Environment Variables for Always Encrypted Migration Runner
# Copy this file to .env and edit with your actual values

SQL_CONNECTION_STRING=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=YourDatabase;Persist Security Info=False;User ID=yourusername;Password=yourpassword;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
AKV_KEY_ID=https://your-keyvault.vault.azure.net/keys/your-key-name
AE_CMK_NAME=CMK_App
AE_MIGRATION_SCRIPT=